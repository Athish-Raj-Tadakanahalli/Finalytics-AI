# Finalytics AI Environment Configuration
# Copy this file to .env and customize for local or production use

# Security: Generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database URL:
# For local SQLite: leave commented or use sqlite:///finance.db
# DATABASE_URL=sqlite:///finance.db
# For production PostgreSQL (Supabase, Neon, Render, Railway):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# Flask Environment (development or production)
FLASK_ENV=production
